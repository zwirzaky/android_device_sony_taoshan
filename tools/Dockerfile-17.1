FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-8-jdk \
        python3 python-is-python3 \
        git curl wget ca-certificates openssh-client \
        zip unzip rsync bc bison flex gperf m4 \
        build-essential g++-multilib gcc-multilib \
        libc6-dev-i386 lib32z1-dev lib32readline-dev \
        lib32stdc++6 lib32z1 libncurses5 libncurses5-dev libtinfo5 \
        libssl-dev libelf-dev libxml2-utils xsltproc pngcrush \
        schedtool ccache imagemagick gettext \
        liblz4-tool lzop device-tree-compiler \
        xz-utils squashfs-tools \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV PATH=${JAVA_HOME}/bin:${PATH}
ENV LC_ALL=C
ENV LANG=C
ENV USE_CCACHE=1
ENV CCACHE_DIR=/ccache
ENV CCACHE_EXEC=/usr/bin/ccache

RUN useradd -m -u 1000 -U builder
USER builder
WORKDIR /src
