allow qti_init_shell sysfs_devices_system_cpu:file setattr;
allow qti_init_shell sysfs:file write;
allow qti_init_shell sysfs_thermal:file write;
allow qti_init_shell shell_exec:file { getattr open read execute execute_no_trans entrypoint };
allow qti_init_shell self:capability sys_resource;
set_prop(qti_init_shell, ctl_default_prop)
set_prop(qti_init_shell, ctl_location_mq_prop)
set_prop(qti_init_shell, ctl_lowi-server_prop)
set_prop(qti_init_shell, ctl_quipc_main_prop)
allow qti_init_shell bluetooth_loader_exec:file { open read };
allow qti_init_shell hci_attach_dev:chr_file { ioctl open read write };
