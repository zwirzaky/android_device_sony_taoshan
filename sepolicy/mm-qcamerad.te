type_transition mm-qcamerad system_data_file:sock_file camera_socket "cam_socket0";
allow mm-qcamerad camera_device:chr_file { ioctl open read write };
# V4L2 exposes the camera index through a generic sysfs "id" node on this
# platform.  The vendor policy only labels .../video4linux/video*/name.
allow mm-qcamerad sysfs:file r_file_perms;
allow mm-qcamerad system_file:file execmod;
allow mm-qcamerad system_data_file:dir { add_name remove_name write };
allow mm-qcamerad system_data_file:sock_file unlink;
